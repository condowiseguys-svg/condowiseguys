# --- Site ---
# Public address of this app, no trailing slash. http://localhost:3000 for local work.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this one in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Developers > API keys, with "Test mode" switched on) ---
# Must start with sk_test_. A live key is refused unless STRIPE_ALLOW_LIVE=true.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint /api/stripe/webhook (starts with whsec_).
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=false

# --- Quick Scan ---
# Price in cents and currency. 14900 = $149.00
QUICK_SCAN_PRICE_CENTS=14900
QUICK_SCAN_CURRENCY=cad

# --- Admin ---
# Comma-separated emails that may open /admin and release reports.
ADMIN_EMAILS=

# --- Email notices (optional, https://resend.com) ---
# Leave blank to skip notices; everything else still works.
RESEND_API_KEY=
EMAIL_FROM="Condo Wise Guys <orders@condowiseguys.com>"

# --- Trigger.dev ---
TRIGGER_SECRET_KEY=
